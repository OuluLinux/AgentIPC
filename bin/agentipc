#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""Run agentipc from a checkout; works through symlinks, Python 2.7 and 3."""

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)

from agentipc.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
